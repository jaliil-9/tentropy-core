# TENTROPY Open Core - Environment Variables
# Copy this file to .env.local and fill in the values

# E2B API Key (Required for code execution)
# Get your key at https://e2b.dev
E2B_API_KEY=your_e2b_api_key

# Optional: Custom E2B template (speeds up sandbox creation)
# E2B_TEMPLATE_ID=your_template_id

# Optional: Rate limiting with Upstash Redis
# Get your keys at https://upstash.com
# UPSTASH_REDIS_REST_URL=your_redis_url
# UPSTASH_REDIS_REST_TOKEN=your_redis_token

# Note: Supabase is NOT required for the open-core version
# For the full experience with auth, progress tracking, and certificates,
# visit https://tentropy.co
